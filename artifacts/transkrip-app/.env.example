# =============================================================
# Transkrip & Ijazah — Konfigurasi Environment
# =============================================================
# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
#
# File .env TIDAK boleh di-commit ke Git.
# =============================================================


# -------------------------------------------------------------
# Django Core
# -------------------------------------------------------------

# Secret key Django — WAJIB diganti, gunakan string acak panjang.
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=ganti-dengan-secret-key-yang-aman-dan-panjang

# Mode debug: True untuk development, False untuk production
DEBUG=True

# Host yang diizinkan (koma-separated). Contoh: localhost,127.0.0.1,192.168.1.50
ALLOWED_HOSTS=localhost,127.0.0.1

# Origin yang dipercaya untuk CSRF (perlu diisi jika pakai reverse proxy / HTTPS)
# Contoh: https://transkrip.kampus.ac.id
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com


# -------------------------------------------------------------
# Neo Feeder PDDIKTI
# -------------------------------------------------------------
# Server Neo Feeder adalah server lokal kampus.
# Komputer harus terhubung ke jaringan yang sama (intranet/VPN).
# Endpoint yang digunakan: http://{FEEDER_HOST}:3003/ws/live2.php

# IP atau hostname server Neo Feeder (tanpa http://)
FEEDER_HOST=192.168.1.100

# Kredensial login Neo Feeder
FEEDER_USERNAME=username_anda
FEEDER_PASSWORD=password_anda

# Bila True: saat Neo Feeder tidak punya data nilai, transkrip memakai hasil
# scraping DHS eCampuz (data/ecampuz/out/dhs_<nim>.json) sebagai fallback.
FALLBACK_DHS_SAAT_FEEDER_KOSONG=True


# -------------------------------------------------------------
# Konfigurasi Transkrip
# -------------------------------------------------------------

# Nama dekan yang tampil di transkrip jika tidak di-override per mahasiswa
DEFAULT_NAMA_DEKAN=Dr. Nama Dekan, M.T.
